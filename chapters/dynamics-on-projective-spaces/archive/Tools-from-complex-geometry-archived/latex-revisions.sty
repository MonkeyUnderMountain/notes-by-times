\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{latex-revisions}[2026/10/23 Visible LaTeX revision marks]
\RequirePackage{xcolor}
\RequirePackage[normalem]{ulem}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\DeclareRobustCommand{\latexdeleted}[1]{\sout{#1}}
\DeclareRobustCommand{\latexgrammar}[1]{%
  \begingroup
  \setlength{\fboxsep}{2pt}%
  \colorbox{yellow}{#1}%
  \endgroup
}
\DeclareRobustCommand{\latexmath}[1]{%
  \begingroup
  \setlength{\fboxsep}{2pt}%
  \colorbox{red!50}{#1}%
  \endgroup
}
% Math-mode counterparts preserve display, text, and subscript styles.
% Wrap individual expressions, not alignment tabs or whole environments.
\DeclareRobustCommand{\latexdeletedmath}[1]{%
  \mathpalette\latexrevision@deletedmath{#1}%
}
\newcommand{\latexrevision@deletedmath}[2]{%
  \mbox{\latexdeleted{\ensuremath{#1#2}}}%
}
\DeclareRobustCommand{\latexaddedmath}[1]{%
  \mathpalette\latexrevision@addedmath{#1}%
}
\newcommand{\latexrevision@addedmath}[2]{%
  \mbox{\latexmath{\ensuremath{#1#2}}}%
}
\tcbset{latexrevision/.style={%
  enhanced jigsaw,
  breakable,
  frame hidden,
  boxrule=0pt,
  sharp corners,
  boxsep=0pt,
  left=4pt,right=4pt,top=4pt,bottom=4pt,
  before skip=4pt,after skip=4pt,
  coltext=black
}}
\newtcolorbox{latexmathchange}{latexrevision,colback=red!50}
\newtcolorbox{latexgrammarchange}{latexrevision,colback=yellow}
\endinput
